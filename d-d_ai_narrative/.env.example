POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_PORT=5432
# URL de connexion Prisma (construite à partir des variables ci-dessus)
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydatabase
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=30000

# --- Prod (VPS / docker-compose.prod.yaml) ---
# Nom de domaine (ou sous-domaine) de l'app, utilisé par Traefik pour le routage + HTTPS
DOMAIN=dnd.tondomaine.fr
# Secret NextAuth, generer avec: openssl rand -base64 33
AUTH_SECRET=
# Requis car l'app tourne derriere le reverse proxy Traefik
AUTH_TRUST_HOST=true
# Origines autorisees en CORS (utilise par proxy.ts), separees par virgule
ALLOWED_ORIGINS=https://dnd.tondomaine.fr

# Code d'acces requis pour visiter le site pendant l'alpha.
# Laisser vide/absent desactive la porte d'acces.
ALPHA_ACCESS_CODE=